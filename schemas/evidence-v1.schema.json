{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kozphy:karba:evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "case_id", "agent_id", "trial_index", "outcome",
    "merge_authorized", "human_gate", "agent_claims", "verified",
    "commands", "security_findings", "environment", "evidence_sha256", "created_at"
  ],
  "properties": {
    "schema": { "const": "karba.evidence.v1" },
    "run_id": { "type": "string" },
    "case_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "trial_index": { "type": "integer", "minimum": 0 },
    "outcome": { "enum": ["accepted", "rejected", "infra_error"] },
    "merge_authorized": { "const": false },
    "human_gate": { "const": "PENDING" },
    "agent_claims": { "type": "object" },
    "verified": { "type": "object" },
    "commands": { "type": "array" },
    "security_findings": { "type": "array" },
    "environment": { "type": "object" },
    "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string" },
    "notes": { "type": "string" }
  }
}